{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Adapters": {
    "WhatsApp": {
      "VerifyToken": "dev-verify-token"
    }
  },
  "Persistence": {
    "SqliteConnectionString": "Data Source=rideclub-dev.db"
  },
  "Otlp": {
    "Endpoint": "http://aspire-dashboard:18889"
  },
  "MassTransit": {
    "TransportType": "InMemory",
    "ConcurrencyLimit": 10
  }
}
