{
  "metadata": {
    "src": [
      {
        "files": ["src/**/*.csproj"],
        "src": "../"
      }
    ],
    "dest": "api"
  },
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["articles/**.md", "toc.yml", "index.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "dest": "_site",
    "template": ["default", "modern"]
  }
}
