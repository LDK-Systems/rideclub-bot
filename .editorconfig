root = true

[*]

charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4

################################################################################
# C#
################################################################################

[*.cs]

indent_size = 4

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

dotnet_style_require_accessibility_modifiers = always:error

dotnet_style_predefined_type_for_locals_parameters_members = true

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

dotnet_style_null_propagation = true

dotnet_style_coalesce_expression = true

dotnet_style_prefer_auto_properties = true

dotnet_style_prefer_collection_expression = true

csharp_style_var_for_built_in_types = false

csharp_style_var_when_type_is_apparent = true

csharp_style_var_elsewhere = false

csharp_style_namespace_declarations = file_scoped

csharp_new_line_before_open_brace = all

csharp_prefer_braces = true:error

csharp_style_expression_bodied_methods = false

################################################################################
# Naming
################################################################################

dotnet_naming_rule.private_fields_should_be_camel.severity = suggestion

dotnet_naming_rule.private_fields_should_be_camel.symbols = private_fields

dotnet_naming_rule.private_fields_should_be_camel.style = camel_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field

dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_prefix.required_prefix = _

dotnet_naming_style.camel_prefix.capitalization = camel_case

################################################################################
# Analyzer severity
################################################################################

dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_analyzer_diagnostic.category-Performance.severity = warning
dotnet_analyzer_diagnostic.category-Reliability.severity = warning